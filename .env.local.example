# Copia a .env.local (local) o configura en Render → Environment (producción)
# La app usa process.env.GEMINI_API_KEY, process.env.MONGODB_URI, process.env.ADMIN_PASSWORD y process.env.PORT

# Gemini (obligatorio para el chat)
GEMINI_API_KEY=tu_api_key_aqui
# Opcional: modelo. Por defecto gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# Admin: contraseña maestra para /admin y /login
ADMIN_PASSWORD=tu_contraseña_segura

# MongoDB (opcional): para Tabla de Prospección en /admin/dashboard
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname

# Puerto (opcional). Render asigna PORT automáticamente. Local: por defecto 3010
# PORT=3010
