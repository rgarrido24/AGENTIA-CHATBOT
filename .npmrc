# whatsapp-web.js trae puppeteer, que por defecto descarga Chrome en npm install.
# En Render (y otros CI) la descarga o la caché de @puppeteer/browsers suele fallar y tumba el build.
# El servicio web Next no usa ese Chromium; el bridge WhatsApp corre aparte con Chrome/Chromium del sistema.
puppeteer_skip_download=true
