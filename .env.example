# Next.js solo carga automáticamente .env, .env.local, etc.
# Si guardas un respaldo en env-local-restore.txt, copia su contenido a .env.local
# (no renombres el .txt a .env.local sin quitar la extensión correcta).

# API Keys
GEMINI_API_KEY=
# Alternativa (si usas libs de Google que la esperan)
GOOGLE_GENERATIVE_AI_API_KEY=
# Opcional: modelo (por defecto gemini-2.5-flash en health y rutas demo)
GEMINI_MODEL=
# Opcional: endpoint OCR Gemini usado por sale-closure-flow
GEMINI_API_ENDPOINT=

# MONGODB_URI=mongodb://localhost:27017

# MongoDB Atlas (producción en Vercel)
MONGODB_URI=
MONGODB_DB=agentia_chatbot_ventas

# Webhooks META
META_VERIFY_TOKEN=

# Admin (login/dashboard)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Google Calendar (opcional — OAuth por cliente)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_CALENDAR_ID=
# Service account Biovela (recolección en almacén)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# También soporta: GOOGLE_CALENDAR_ID_<CLIENT_ID_SANITIZADO>

# Google Wallet — SABUCAN lealtad (pase "Guardar en Google Wallet")
# Issuer ID del Google Pay & Wallet Console
GOOGLE_WALLET_ISSUER_ID=
# JSON completo de la service account (una sola línea). private_key con \n escapados.
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
# Logo Cloudinary (mismo asset de la Loyalty Class). Visible en /sabucan/*
NEXT_PUBLIC_SABUCAN_LOGO_URL=

# SABUCAN caja — login en /sabucan/caja y /sabucan/buscar
SABUCAN_ADMIN_USER=
SABUCAN_ADMIN_PASSWORD=

# Carnitas Granada caja — login en /carnitas/*
CARNITAS_ADMIN_USER=
CARNITAS_ADMIN_PASSWORD=
# % de cashback en puntos (1 punto = $1 MXN). Default 5 si se deja vacío.
NEXT_PUBLIC_CARNITAS_CASHBACK_PCT=
# Logo (mismo asset de la Loyalty Class). Opcional, hay default en el código.
NEXT_PUBLIC_CARNITAS_LOGO_URL=


# Para deploy en Vercel: URL pública de tu app (ej: https://dashboard.agentia.io)
# Usado por: scripts/whatsapp-bridge.js, cron, webhooks internos
AGENTIA_CHATBOT_API_URL=https://dashboard.agentia.io
CRON_SECRET=

# QR de WhatsApp (proteger POST a /api/whatsapp/qr-store)
WHATSAPP_QR_SECRET=

# WhatsApp Cloud API (Meta) — webhook /api/webhook/whatsapp + envío de respuestas
# Verificación GET: WHATSAPP_VERIFY_TOKEN (ver route.ts; fallback en código para dev)
WHATSAPP_VERIFY_TOKEN=
# CWF México
WHATSAPP_PHONE_NUMBER_ID=
# Agentia (+52 984 492 7769) — App ID 1702592241147569
AGENTIA_WHATSAPP_PHONE_NUMBER_ID=1137735859429490
WHATSAPP_ACCESS_TOKEN=

# Web Push — PWA paneles CWF y Agentia (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@agentia.software

# Anuario K3 (app/anuariok3asbaje) — https://agentia.software/anuariok3asbaje/dashboard
ANUARIO_K3_ADMIN_PASSWORD=
# Opcional: URI propia; si no, usa MONGODB_URI (colección alumnos vía mongoose)
ANUARIO_K3_MONGODB_URI=
ANUARIO_K3_CLOUDINARY_CLOUD_NAME=
ANUARIO_K3_CLOUDINARY_API_KEY=
ANUARIO_K3_CLOUDINARY_API_SECRET=
ANUARIO_K3_EMAIL_FROM=
ANUARIO_K3_EMAIL_PASS=
ANUARIO_K3_EMAIL_TO=

# Alerta WhatsApp: número que recibe avisos de leads urgentes (ej: 5215512345678)
ALERT_WHATSAPP_NUMBER=
# clientId del bridge que envía las alertas (por defecto: agentia-ventas)
AGENTIA_ALERTS_SENDER_CLIENT_ID=agentia-ventas

# Pipeline Izzi: WhatsApp que recibe alerta al primer mensaje de un lead nuevo (solo dígitos, ej: 529844927769). Por defecto 529844927769.
IZZI_PIPELINE_ALERT_WHATSAPP=

# Sale-closure-flow (izzi)
LEADS_API_BASE_URL=
WHATSAPP_SEND_URL=
WHATSAPP_API_TOKEN=

# Facebook Lead Ads
FB_VERIFY_TOKEN=
FB_APP_SECRET=
FB_PAGE_ACCESS_TOKEN=
# clientId que se asigna a los leads de FB Ads (ej: trafficker)
FB_CLIENT_ID=trafficker
# Número WhatsApp que recibe alerta cuando llega un lead de FB Ads (sin +, ej: 5493515920758)
FB_ALERT_NUMBER=5493515920758

# Cloudflare Turnstile (anti-bot) — get keys at https://dash.cloudflare.com
# Use "Always passes" test keys locally: site=1x00000000000000000000AA secret=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Stripe — pasarela de pagos
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# IDs de precios (generar con: node scripts/stripe-setup.js)
STRIPE_PRICE_STARTER_MXN=
STRIPE_PRICE_PROFESIONAL_MXN=
STRIPE_PRICE_PREMIUM_MXN=
STRIPE_PRICE_STARTER_USD=
STRIPE_PRICE_PROFESIONAL_USD=
STRIPE_PRICE_PREMIUM_USD=
STRIPE_PRICE_ACTIVACION_MXN=
STRIPE_PRICE_ACTIVACION_USD=
# WhatsApp de Rodolfo para alertas de nuevos clientes
RODOLFO_WHATSAPP=
# Landing /ready — CTA "Ver Demo en Vivo" (solo dígitos o +52..., se normaliza). Si está vacío, se usa RODOLFO_WHATSAPP en el servidor.
NEXT_PUBLIC_READY_WHATSAPP_NUMBER=529844927769

# Contratar — Payment Links de Stripe por cliente
STRIPE_PAYMENT_LINK_LUCIANO=
STRIPE_PAYMENT_LINK_DECOHOUSE=
STRIPE_PAYMENT_LINK_BIOVELA_SETUP=
STRIPE_PAYMENT_LINK_BIOVELA_PRORATE=
STRIPE_PAYMENT_LINK_BIOVELA_RECURRING=

# Next / Render
NODE_ENV=production
PORT=3010
NEXT_PUBLIC_APP_URL=

# Widget flotante (sitio). Si AGENTIA_WIDGET_WEBHOOK_URL está vacío, usa el motor interno vía handleChat (clientId agentia).
AGENTIA_WIDGET_WEBHOOK_URL=
# Opcional: Authorization Bearer para el webhook
AGENTIA_WIDGET_WEBHOOK_SECRET=
# CTA “Agendar” (Cal.com / Calendly / etc.)
NEXT_PUBLIC_AGENTIA_BOOK_URL=https://calendly.com/rgarrido24/30min
# CTA WhatsApp Rodolfo (solo dígitos, ej 529844927769). Si vacío, el botón puede caer a /ready
NEXT_PUBLIC_WIDGET_WHATSAPP_DIGITS=529844927769

# Propuesta pública /paycesa (La Rueda Veladoras): URLs de imágenes de la tienda del cliente (opcional)
# NEXT_PUBLIC_PAYCESA_IMG_HERO=
# NEXT_PUBLIC_PAYCESA_IMG_ARTISAN=
# NEXT_PUBLIC_PAYCESA_IMG_LOGISTICS=

# Panel CRM por cliente (/clientes/biovela/panel?token=...)
TOKEN_BIOVELA=
# Proxy al bridge Baileys en Railway (send, qr, status, pause, resume)
BAILEYS_BRIDGE_URL=
