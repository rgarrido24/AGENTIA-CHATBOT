{
  "name": "agentia-manychat-clone",
  "version": "0.1.0",
  "private": true,
  "description": "Agentia ManyChat Clone - API serverless en Vercel con Gemini",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "whatsapp": "node scripts/whatsapp-bridge.js",
    "whatsapp:reset": "node scripts/whatsapp-reset-session.js",
    "whatsapp:kill-browser": "node scripts/whatsapp-kill-browser.js",
    "seed": "node scripts/seed-business-configs.js",
    "purge:knowledge": "node scripts/purge-knowledge.js",
    "test:comment": "node scripts/test-comment-webhook.js",
    "dev:vercel": "node ./node_modules/vercel/dist/index.js dev --listen 3001 --yes",
    "build": "npm install && PUPPETEER_CACHE_DIR=/opt/render/.cache/puppeteer npx puppeteer browsers install chrome && next build" ,
    "dev": "npx next dev -p 3010",
    "typecheck": "tsc --noEmit",
    "start": "next start & node scripts/whatsapp-bridge.js"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.29",
    "@google/generative-ai": "^0.24.1",
    "ai": "^6.0.86",
    "autoprefixer": "^10.4.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "googleapis": "^144.0.0",
    "lucide-react": "^0.563.0",
    "mongodb": "^7.1.0",
    "next": "^14.2.35",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.5.6",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.19",
    "whatsapp-web.js": "^1.34.6"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@vercel/node": "^3.2.27",
    "typescript": "^5.7.3",
    "vercel": "^50.12.1"
  }
}
